# ============================================================
# 一畳屋 統合業務システム 環境変数の例
# 実際の値は .env.local (ローカル) か Vercel の Environment Variables に設定する。
# このファイルには値を書かない (秘密情報をコミットしない)
# ============================================================

# --- データベース (Supabase) ---
# 2 つとも設定すると Supabase、未設定なら data/<DATA_FILE_NAME> の JSON (ローカル検証用) で動作する
NEXT_PUBLIC_SUPABASE_URL=
# secret キー (sb_secret_...)。サーバー側だけで使う。ブラウザに出る NEXT_PUBLIC_ を付けない
SUPABASE_SECRET_KEY=
# publishable キー (現在のアプリでは未使用。RLS によりこのキーではデータを読めない)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- セッション ---
# ログイン Cookie の署名鍵 (32 文字以上のランダムな文字列)。
# 未設定なら SUPABASE_SECRET_KEY から導出する。変更すると全員が再ログインになる
# SESSION_SECRET=

# --- ローカル検証 ---
# json にすると Supabase の設定があっても JSON ファイルを使う (本番データを触らずに試す)
# DATA_BACKEND=json
# データファイル名 (data/ 配下, 省略時: db.json。ファイルがなければサンプルデータを生成)
# DATA_FILE_NAME=db.json

# --- 確認用ログイン (お客様の画面確認用。/review?key=… を開いた端末にロールのボタンを表示) ---
# 鍵を指定する場合 (16 文字以上)。未設定なら SUPABASE_SECRET_KEY から導出した鍵を使う
# REVIEW_ACCESS_KEY=
# off にすると確認用ログインを止める (確認期間の終了後など)
# REVIEW_LOGIN=off

# --- タイムゾーン (省略時: Asia/Tokyo。Vercel のサーバーは UTC のため、起動時にこの値に設定する) ---
# APP_TIME_ZONE=Asia/Tokyo

# --- AI (Claude API) ---
# 設定すると OCR / AI アシスタントが実際の Claude API で動く。未設定ならサンプル応答
# ANTHROPIC_API_KEY=

# --- SQL の実行スクリプト専用 (scripts/import/setup-database.mjs で ichijoya.sql を実行するとき。アプリ本体では使わない) ---
# 記号 (# % など) を含むときは '...' で囲む
# SUPABASE_DB_PASSWORD=
# または接続文字列 (Supabase の Connect → Session pooler)
# SUPABASE_DB_URL=
