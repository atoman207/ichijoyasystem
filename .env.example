# ============================================================
# 一畳屋 統合業務システム 環境変数の例
# 実際の値は .env.local (ローカル) か Vercel の Environment Variables に設定する。
# このファイルには値を書かない (秘密情報をコミットしない)
# ============================================================

# --- データベース (Supabase) ---
# 2 つとも設定すると Supabase、未設定なら data/<DATA_FILE_NAME> の JSON (ローカル検証用) で動作する
NEXT_PUBLIC_SUPABASE_URL=
# secret キー (sb_secret_...)。サーバー側だけで使う。ブラウザに出る NEXT_PUBLIC_ を付けない
SUPABASE_SECRET_KEY=
# publishable キー (現在のアプリでは未使用。RLS によりこのキーではデータを読めない)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- セッション ---
# ログイン Cookie の署名鍵 (32 文字以上のランダムな文字列)。
# 未設定なら SUPABASE_SECRET_KEY から導出する。変更すると全員が再ログインになる
# SESSION_SECRET=

# --- ローカル検証 ---
# json にすると Supabase の設定があっても JSON ファイルを使う (本番データを触らずに試す)
# DATA_BACKEND=json
# データファイル名 (data/ 配下, 省略時: db.json。ファイルがなければサンプルデータを生成)
# DATA_FILE_NAME=db.json

# --- ファイル (添付ファイル・写真・顔写真) の保存先 ---
# ファイルの本体はサーバーのディスクにだけ置く (Supabase には台帳の文字とパスだけ)。
# 既定: 本番サーバー (/srv/ichijoya がある) は /srv/ichijoya/data/uploads、それ以外は data/uploads
# FILE_STORAGE_DIR=
# データの控え (再起動のときに Supabase から全件を読み直さないため)。既定: /srv/ichijoya/data/cache または data/cache。off で使わない
# DB_CACHE_DIR=
# DB_SNAPSHOT=off

# --- 確認用ログイン (お客様の画面確認用。/review?key=… を開いた端末にロールのボタンを表示) ---
# 鍵を指定する場合 (16 文字以上)。未設定なら SUPABASE_SECRET_KEY から導出した鍵を使う
# REVIEW_ACCESS_KEY=
# 既定は停止 (2026-11-18 に確認用アカウントを削除)。on にすると確認用ログインを使える (確認用アカウントが初回に作られる)
# REVIEW_LOGIN=on

# --- アカウントの変更の停止 (テスト期間中) ---
# 既定は停止: 設定 → ユーザーと権限・社員管理で、アカウントの情報の変更・追加・削除・有効と無効の切り替え・新規登録の承認を止める
# (ボタンを押すと「テスト期間中のため…」を表示。パスワードの再設定・本人のプロフィールの変更はできる)。off で解除
# ACCOUNT_EDIT_LOCK=off

# --- タイムゾーン (省略時: Asia/Tokyo。Vercel のサーバーは UTC のため、起動時にこの値に設定する) ---
# APP_TIME_ZONE=Asia/Tokyo

# --- AI (書類の AI 読取・アンケートはがきの読取・お客様の声の分析・AI アシスタント) ---
# どちらか 1 つを設定する。キーの形 (sk-ant- / sk-) で接続先を自動で判定する。未設定ならサンプル応答
# 本番は Vercel の Environment Variables (Production) に同じ名前で設定し、再デプロイすると反映される
# OpenAI のキー (sk-proj-… / sk-…)
# OPENAI_API_KEY=
# Anthropic (Claude) のキー (sk-ant-…)
# ANTHROPIC_API_KEY=
# OpenAI のモデルを固定する場合 (省略時は最新の gpt-6.1-terra。使えないキーでは gpt-4.1)
# OPENAI_MODEL=gpt-6.1-terra
# 両方のキーがあるときの接続先 (省略時は Claude)
# AI_PROVIDER=openai
# 読取の丁寧さ (Claude と OpenAI の推論モデル。low / medium / high。省略時 low = 速い。Vercel の 60 秒以内に収めるため low を推奨)
# AI_EFFORT=low

# --- 外部連携 (メール・LINE・Chatwork・Web フォーム) ---
# 設定がないサービスは送信せず「記録のみ」として送信履歴に残す (設定 → 外部連携・AI で状態とテスト送信)
# 通知・送付文に入れる画面の URL (省略時は Vercel の URL)
# APP_BASE_URL=https://ichijoyasystem.vercel.app
# メール: 会社のメールアカウント (SMTP。優先) か、Resend / SendGrid の API キー。送信元はアカウントと同じドメインのアドレス
# 開発用 (npm run dev・3001 番) は本番と同じデータベースを使うため、ここに SMTP を入れると開発中の操作でもお客様にメールが届く。入れないこと
# SMTP_HOST=sv***.xserver.jp
# SMTP_PORT=465
# SMTP_USER=info@example.co.jp
# SMTP_PASSWORD=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAIL_FROM=株式会社一畳屋 <info@example.co.jp>
# LINE 公式アカウント (Messaging API): 送信のチャネルアクセストークン (長期) と、受信の署名を確かめるチャネルシークレット
# Webhook URL: https://<このシステム>/api/integrations/line (ドメイン設定後、設定 → 外部連携・AI の「LINE の Webhook URL をこのシステムに設定」で自動設定)
# グループ (現場ごと) で使うときは、LINE Official Account Manager で「グループ・複数人チャットへの参加を許可する」をオン
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# Chatwork: API トークン (送信)、社内通知を投稿するルーム ID、Webhook のトークン (受信の署名の確認)
# Webhook URL: https://<このシステム>/api/integrations/chatwork
# CHATWORK_API_TOKEN=
# CHATWORK_ROOM_ID=
# Webhook はルームごとに作る (トークンもルームごとに違う)。複数のルームはカンマ区切り: CHATWORK_WEBHOOK_TOKEN=tokenA,tokenB
# CHATWORK_WEBHOOK_TOKEN=
# API トークンの持ち主のアカウント ID (自分の投稿を受信として記録しないため。任意)
# CHATWORK_SELF_ACCOUNT_ID=
# Web サイトのお問い合わせフォーム: 受信の共有鍵 (フォームのサーバーから Authorization: Bearer <鍵> で POST)
# POST https://<このシステム>/api/integrations/webform
# WEBFORM_SECRET=
# 既存の AI システム (AI テキスト相談・AI 音声相談・AI 電話受付) からの受信の共有鍵
# POST https://<このシステム>/api/integrations/ai-intake?source=chat|voice|phone (Authorization: Bearer <鍵>)
# AI_INTAKE_SECRET=

# --- 地図・住宅地図 ---
# Google マップのリンク (地図で開く・経路案内) はキー不要。住所から位置を求めるボタン (場所の画面・1 件ずつ) を使うときだけ Geocoding API のキー
# 予定の提案の移動時間に Google の経路 (Routes API の computeRouteMatrix) を使うときも同じキー (Routes API を有効にする)。
# 使うのは 予定表 → 仕事量と提案の設定 →「経路」で Google を選び、社内の承認にチェックしたときだけ (緯度経度だけを送る。月の上限あり)
# GOOGLE_MAPS_API_KEY=
# 経路の結果の保存先 (SQLite。30 日再利用。off = 保存しない。省略時: 本番は /srv/ichijoya/data/cache/routing.sqlite、サンプルデータは data/cache/)
# ROUTING_DB_PATH=
# 住宅地図の PDF の一括取込で、PDF と manifest.csv を置くフォルダー (省略時: 添付ファイルの保存先の隣の map-import)
# MAP_IMPORT_DIR=/srv/ichijoya/data/map-import
# ゼンリンの公式 API (契約と仕様の確認がとれ、src/lib/maps/providers.ts にアダプターを追加したときだけ)。
# ZENRIN_LICENSE_CONFIRMED=yes は「社内サーバーへの保存と社内の複数人での閲覧」が契約で認められていることを確認した場合だけ設定する
# ZENRIN_API_ENDPOINT=
# ZENRIN_API_KEY=
# ZENRIN_LICENSE_CONFIRMED=

# --- Google スプレッドシート (非公開のシートの直接同期。src/lib/google/sheets.ts) ---
# 未設定なら、リンクを知っている全員が閲覧できるシートだけを読む (公開の書き出し)。
# サービスアカウントの鍵を設定すると、そのサービスアカウントのメールアドレスに「閲覧者」で共有したシートを Sheets API で読む
# (データ入出力の取込・社内資料の同期。設定 → 外部連携・AI に共有先のメールアドレスを表示)。読み取りだけ (spreadsheets.readonly)
# 作り方: Google Cloud のプロジェクトで「Google Sheets API」を有効にする → IAM と管理 → サービスアカウントを作成 (ロールは不要)
#        → 「鍵」→ 鍵を追加 → JSON をダウンロード。鍵の JSON はコミットしない
# どちらか 1 つ。JSON は 1 行にした JSON そのまま か base64 (base64 -w0 key.json)。FILE はサーバー上の鍵のファイルのパス (読める権限を絞る)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/ichijoya/google-service-account.json
# 検証用の接続先の差し替え (テストのモックだけ。通常は設定しない)
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_SHEETS_API_BASE=
# SHEETS_EXPORT_BASE=

# --- 定期実行 (サーバーの cron から呼ぶ。社内資料の Google スプレッドシートの同期) ---
# POST https://<このシステム>/api/cron/knowledge-sync (Authorization: Bearer <鍵>)
# CRON_SECRET=
# バックアップの結果のファイル (deploy/backup.sh が書く。設定 → 本番運用の準備 に表示)
# BACKUP_STATUS_FILE=/var/lib/ichijoya/backup-status.json

# --- データベースへの直接接続 (アプリ本体では使わない) ---
# 使う場面: テーブル定義の自動反映 (npm run build の前の prebuild = scripts/import/migrate.mjs、npm run db:migrate)、
#           ichijoya.sql の実行 (scripts/import/setup-database.mjs)
# Vercel にも設定すると、デプロイのたびにテーブル定義 (schema.ts) の追加分が Supabase に反映される (データは変えない)
# 記号 (# % など) を含むときは '...' で囲む
# SUPABASE_DB_PASSWORD=
# または接続文字列 (Supabase の Connect → Session pooler)
# SUPABASE_DB_URL=

# 「質問する」の音声 (読み上げ・音声入力)。OpenAI のキー (OPENAI_API_KEY) があれば使う。止めるときは AI_VOICE=off
# 声 (既定 nova・20 代の日本人女性として話すよう指示)・モデル・1 人 1 時間の回数の上限は、変えるときだけ設定する
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# VOICE_TTS_PER_HOUR=200
# VOICE_STT_PER_HOUR=120
# AI_VOICE=off

# AI アシスタントの予算 (画面の AI アシスタント →「品質・費用」の設定が優先)。超えたら月末まで AI を使わずに答える
# AI_MONTHLY_BUDGET_JPY=10000
# AI_MONTHLY_TOKEN_LIMIT=0
# AI_USD_JPY=150
# 相談の履歴の保存期間 (日)・履歴の集計の表 (お客様の名前などを含む) の保存期間・AI の呼び出しの記録 (数だけ) の保存期間
# CHATBOT_LOG_RETENTION_DAYS=730
# CHATBOT_LOG_TABLE_DAYS=90
# AI_CALLS_RETENTION_DAYS=400
