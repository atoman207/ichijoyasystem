{
  "name": "ichijoyasistem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev/run-capped.sh dev next dev -p 3001",
    "prebuild": "node scripts/chatbot/extract-ui.mjs && node scripts/import/migrate.mjs --if-configured",
    "build": "bash scripts/dev/run-capped.sh build next build",
    "start": "next start",
    "deploy": "bash deploy/deploy.sh",
    "env:apply": "sudo bash deploy/env-apply.sh .env.local --keys 'SMTP_ MAIL_FROM LINE_ CHATWORK_ WEBFORM_SECRET AI_INTAKE_SECRET PHONE_INTAKE_SECRET OPENAI_API_KEY ANTHROPIC_API_KEY RESEND_API_KEY SENDGRID_API_KEY FAX_ GOOGLE_MAPS_ GOOGLE_SERVICE_ACCOUNT_ MAP_IMPORT_DIR ZENRIN_'",
    "lint": "eslint",
    "smoke": "node scripts/smoke.mjs",
    "db:sql": "node scripts/import/generate-data-sql.mjs",
    "db:setup": "node scripts/import/generate-data-sql.mjs && node scripts/import/setup-database.mjs",
    "db:migrate": "node scripts/import/generate-schema.mjs && node scripts/import/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test:maps": "node scripts/tests/maps/address.test.mjs && node scripts/tests/maps/logic.test.mjs && node scripts/tests/maps/batch.test.mjs",
    "test:mgmt": "node scripts/tests/mgmt/mgmt.test.mjs",
    "test:reports": "node scripts/tests/reports/reports.test.mjs",
    "test:schedule": "node scripts/tests/schedule/schedule.test.mjs && node scripts/tests/schedule/holidays.test.mjs",
    "test:ops-reports": "node scripts/tests/ops-reports/ops-reports.test.mjs",
    "test:assistant-actions": "node scripts/tests/assistant-actions/actions.test.mjs",
    "test:chatbot": "node scripts/tests/chatbot/unit.test.mjs && node scripts/tests/chatbot/mock-ai.test.mjs",
    "chatbot:catalog": "node scripts/chatbot/extract-ui.mjs",
    "test:hr": "node scripts/tests/hr/leave.test.mjs",
    "test:office": "node scripts/tests/office/office.test.mjs",
    "test:registry": "node scripts/tests/registry/registry.test.mjs",
    "test:drafts": "node scripts/tests/drafts/drafts.test.mjs",
    "test:knowledge": "node scripts/tests/knowledge/knowledge.test.mjs",
    "test:acceptance": "node scripts/tests/chatbot/acceptance.test.mjs",
    "test:intake": "node scripts/tests/ai-intake/intake.test.mjs",
    "test:reception": "node scripts/tests/reception/reception.test.mjs",
    "test:kpi-import": "node scripts/tests/kpi-import/workbook.test.mjs && node scripts/tests/kpi-import/basis.test.mjs",
    "kpi:import-workbook": "node scripts/ops/import-survey-workbook.mjs",
    "test:capture": "node scripts/tests/capture/quote-calc.test.mjs && node scripts/tests/capture/camera-pick.test.mjs",
    "test:capture-ui": "node scripts/tests/capture/camera.e2e.mjs",
    "test:sales": "node scripts/tests/sales/reconcile.test.mjs",
    "test:case-access": "node scripts/tests/case-access/case-access.test.mjs",
    "test:posts-tidy": "node scripts/tests/posts-tidy/posts-tidy.test.mjs",
    "test:finance": "node scripts/tests/finance/finance.test.mjs",
    "test:carryover": "node scripts/tests/carryover/carryover.test.mjs",
    "testweek:carryover": "node scripts/ops/testweek-carryover.mjs",
    "test:assistant": "npm run test:chatbot && npm run test:acceptance && npm run test:knowledge && npm run test:drafts && npm run test:assistant-actions && npm run test:registry",
    "registry:scan": "node scripts/registry/scan-materials.mjs",
    "registry:promote": "node scripts/registry/promote-knowledge.mjs",
    "registry:supabase": "node scripts/registry/sync-supabase.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
