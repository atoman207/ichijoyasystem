# ============================================================
# 本番サーバー (Xserver VPS) の設定: /etc/ichijoya/ichijoya.env に置く (所有者 root・権限 640・グループ ichijoya)
#   sudo install -m 640 -o root -g ichijoya deploy/ichijoya.env.example /etc/ichijoya/ichijoya.env
#   sudo nano /etc/ichijoya/ichijoya.env   (値を入れる)
# 値はこのファイルにだけ書く。リポジトリ・メール・チャットに貼らない
# ============================================================

# --- 必須: データベース (Supabase の Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- 必須: ログインの署名の鍵 (32 文字以上のランダムな文字列。openssl rand -base64 48 で作る) ---
SESSION_SECRET=

# --- 必須: このシステムの URL (通知・帳票のリンク・Webhook の受信先に使う。末尾の / なし) ---
APP_BASE_URL=https://__DOMAIN__

# --- データベースの更新 (デプロイのたびに表の追加を自動で行う) とバックアップ (pg_dump) ---
# Supabase の Connect → Session pooler の URI (パスワードの記号は URL エンコードする)
SUPABASE_DB_URL=

# --- AI (どちらか 1 つ。OpenAI は既定で最新の gpt-6.1-terra を使う) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- 外部連携 (使うものだけ) ---
# メール: 会社のメールアカウント (SMTP。Xserver なら sv***.xserver.jp・465)。値は deploy/env-apply.sh で書き込むとよい
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# (SMTP の代わりに Resend を使うとき) RESEND_API_KEY=
# MAIL_FROM=株式会社一畳屋 <info@example.co.jp>
# LINE (Webhook URL: https://__DOMAIN__/api/integrations/line。設定 → 外部連携・AI のボタンで自動設定)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# Chatwork (Webhook URL: https://__DOMAIN__/api/integrations/chatwork。ルームごとの Webhook のトークンをカンマ区切り)
# CHATWORK_API_TOKEN=
# CHATWORK_ROOM_ID=
# CHATWORK_WEBHOOK_TOKEN=
# CHATWORK_SELF_ACCOUNT_ID=
# WEBFORM_SECRET=
# 既存の AI システム (AI テキスト相談・AI 音声相談・AI 電話受付) からの受信の共有鍵
# AI_INTAKE_SECRET=

# --- 定期実行 (社内資料のスプレッドシート同期) の共有鍵 ---
CRON_SECRET=

# --- バックアップの状況を設定画面に表示する (backup.sh が書く) ---
BACKUP_STATUS_FILE=/var/lib/ichijoya/backup-status.json

# --- タイムゾーン ---
APP_TIME_ZONE=Asia/Tokyo
