# 一畳屋 業務システム (Next.js) の常駐サービス
# setup-server.sh が /etc/systemd/system/ichijoya.service にコピーする
#   状態: systemctl status ichijoya / ログ: journalctl -u ichijoya -f / 再起動: systemctl restart ichijoya

[Unit]
Description=Ichijoya business system (Next.js)
After=network-online.target
Wants=network-online.target
# 何度失敗しても再起動を続ける (既定の「10 秒に 5 回失敗したら諦める」をなくす)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ichijoya
Group=ichijoya
WorkingDirectory=/srv/ichijoya/current
# 秘密の設定 (所有者 root・権限 640。グループ ichijoya が読める)
EnvironmentFile=/etc/ichijoya/ichijoya.env
Environment=NODE_ENV=production
Environment=PORT=3000
# ProtectHome で /home に書けないため、Next.js の利用統計 (ホームに設定を書く) を止める
Environment=NEXT_TELEMETRY_DISABLED=1
# 待ち受けるアドレス。ドメインで公開した後は nginx (443) だけを公開し、アプリは 127.0.0.1:3000 で待ち受ける。
# ドメインがまだないあいだは、設定ファイルの BIND_HOST=0.0.0.0 で http://<IP アドレス>:3000 から開けるようにする
Environment=BIND_HOST=127.0.0.1
ExecStart=/bin/sh -c 'exec /srv/ichijoya/current/node_modules/.bin/next start -p 3000 -H "$BIND_HOST"'
# 止まったら (異常終了・メモリ不足で止められた・手で止めた以外) 3 秒後に起動し直す。VPS の起動時にも自動で起動する (WantedBy)
Restart=always
RestartSec=3
# 起動時に全データ (約 6 万行) を読み込むため、待ち時間を長めにする
TimeoutStartSec=180
# メモリが不足したときにほかのサービスを巻き込まないよう上限を決める (VPS のメモリに合わせて調整)
MemoryMax=3G
# サーバー全体のメモリが足りなくなったとき、本番のアプリは最後に止められるようにする (開発用のサーバー・エディタが先)
OOMScoreAdjust=-900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/ichijoya /var/lib/ichijoya

[Install]
WantedBy=multi-user.target
